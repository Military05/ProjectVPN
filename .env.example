# =========================
# TELEGRAM BOT
# =========================

BOT_TOKEN=replace_me

# =========================
# PUBLIC SUBSCRIPTION
# =========================

PUBLIC_SUBSCRIPTION_BASE_URL=https://sub.sotervpn.ru
SUBSCRIPTION_TOKEN=soter

# =========================
# DATABASE / REDIS
# =========================

POSTGRES_USER=shopbot
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=shopbot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://shopbot:replace_me@postgres:5432/shopbot

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# =========================
# YOOKASSA
# =========================

YOOKASSA_SHOP_ID=replace_me
YOOKASSA_SECRET_KEY=replace_me

# =========================
# SUBSCRIPTION API ON VPS
# =========================

HOST=0.0.0.0
PORT=8080
USERS_DIR=/opt/sotervpn-sub/users
DEFAULT_DAYS=30

# =========================
# 3X-UI PANELS
# Real values must be stored only in .env on VPS.
# Do not commit real credentials.
# =========================

NL_PANEL_BASE_URL=https://replace-me
NL_PANEL_USERNAME=replace_me
NL_PANEL_PASSWORD=replace_me
NL_INBOUND_ID=1

DE_PANEL_BASE_URL=https://replace-me
DE_PANEL_USERNAME=replace_me
DE_PANEL_PASSWORD=replace_me
DE_INBOUND_ID=1
